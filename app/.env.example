# === PrimerPaso — plantilla de variables de entorno ===
# Copia este archivo como ".env" y completa los valores marcados con COMPLETA.
# Las variables NEXT_PUBLIC_* se exponen al navegador (son públicas).

# --- Base de datos ---
# MVP con SQLite (ruta ABSOLUTA recomendada en Windows para evitar ambigüedad):
DATABASE_URL="file:C:/ruta/a/PrimerPaso/prisma/dev.db"
# En producción, PostgreSQL (cambia también el provider en prisma/schema.prisma):
# DATABASE_URL="postgresql://usuario:clave@localhost:5432/primerpaso?schema=public"

# --- Autenticación ---
# COMPLETA: cadena larga y aleatoria para firmar sesiones.
AUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
SESSION_TTL_HOURS="168"

# --- Red Stellar (Testnet) ---
NEXT_PUBLIC_STELLAR_NETWORK="TESTNET"
NEXT_PUBLIC_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
NEXT_PUBLIC_HORIZON_URL="https://horizon-testnet.stellar.org"
NEXT_PUBLIC_SOROBAN_RPC_URL="https://soroban-testnet.stellar.org"
NEXT_PUBLIC_FRIENDBOT_URL="https://friendbot.stellar.org"

# --- Contratos y token de prueba (del despliegue; son públicos) ---
NEXT_PUBLIC_LOAN_CONTRACT_ID="C..."        # contrato de préstamo
NEXT_PUBLIC_HISTORY_CONTRACT_ID="C..."     # contrato de historial
NEXT_PUBLIC_USDC_SAC_ID="C..."             # token USDC de prueba (SAC)
NEXT_PUBLIC_USDC_CODE="USDC"
NEXT_PUBLIC_USDC_ISSUER="G..."             # emisor del USDC de prueba
NEXT_PUBLIC_ADMIN_ADDRESS="G..."           # dirección del admin/plataforma

# --- SEP-10 (autenticación de wallet) ---
NEXT_PUBLIC_SEP10_HOME_DOMAIN="localhost:3000"
NEXT_PUBLIC_SEP10_WEB_AUTH_DOMAIN="localhost:3000"
# COMPLETA: llave del servidor que firma los challenges SEP-10 (sin fondos).
# Genera una con:  stellar keys generate primerpaso-sep10 ; stellar keys show primerpaso-sep10
SEP10_SERVER_SECRET=""

# --- Faucet de USDC de prueba (servidor) ---
# COMPLETA (opcional): secreto del EMISOR del USDC (único que puede acuñar).
#   stellar keys show primerpaso-issuer
STELLAR_ISSUER_SECRET=""
FAUCET_USDC_AMOUNT="500"

# --- Admin (servidor) ---
# COMPLETA (opcional): secreto del admin, para liquidar desde el panel admin.
#   stellar keys show primerpaso-admin
STELLAR_ADMIN_SECRET=""
