# === PrimerPaso — plantilla de variables de entorno ===
# Copia este archivo como ".env.local" y completa los valores.
# Las variables NEXT_PUBLIC_* se exponen al navegador (son públicas).
# Las demás son secretas y solo se usan en el servidor.

# --- Supabase (Project Settings → API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secreta (sb_secret_...): solo en el servidor, nunca en el cliente.
SUPABASE_SECRET_KEY=
# Secreta: conexión directa a Postgres (npm run db:types). Project Settings → Database.
DATABASE_URL=

# --- Seguridad de la autenticación (ver docs/seguridad.md) ---
# MFA (TOTP) obligatorio para operadores y admins.
#   testnet: false (el staff entra solo con contraseña) · producción: true
REQUIRE_STAFF_MFA=false
# CAPTCHA de Cloudflare Turnstile en registro, ingreso y pedido de código.
#   testnet: vacías (sin CAPTCHA) · producción: las claves del sitio en Cloudflare
#   Para probar en local, claves oficiales que siempre aprueban:
#   1x00000000000000000000AA (sitio) y 1x0000000000000000000000000000000AA (secreta)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Límite de intentos por minuto en /api/auth/*, por IP y por correo.
#   testnet: true / 10 · producción: true / 10
AUTH_RATE_LIMIT=true
AUTH_RATE_LIMIT_MAX=10
# Botón de Google (solo estudiantes y garantes). Configura antes el proveedor en Supabase.
#   testnet: false · producción: opcional
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
# Contraseña de las cuentas del seed (solo testnet). Vacía = PrimerPaso2026!
SEED_PASSWORD=

# --- Stellar Testnet ---
NEXT_PUBLIC_STELLAR_NETWORK=
NEXT_PUBLIC_STELLAR_RPC_URL=
NEXT_PUBLIC_LOAN_CONTRACT_ID=
NEXT_PUBLIC_HISTORY_CONTRACT_ID=
NEXT_PUBLIC_USDC_CONTRACT_ID=
TREASURY_ADDRESS=
# Secretas: stellar keys show primerpaso-admin / primerpaso-operator
# En producción ADMIN_SECRET_KEY va vacía: el admin del contrato es multifirma.
ADMIN_SECRET_KEY=
OPERATOR_SECRET_KEY=

# --- SEP-10 (autenticación de wallet) ---
# Secreta: stellar keys show primerpaso-sep10
SEP10_SERVER_SECRET=
SEP10_HOME_DOMAIN=

# --- Cron del indexador ---
CRON_SECRET=

# --- Faucet de testnet (opcional): secreta del emisor del USDC de prueba ---
# stellar keys show primerpaso-issuer
USDC_ISSUER_SECRET=

# --- Duración de cada cuota en segundos (por defecto 2592000 = 30 días; 300 para la demo) ---
LOAN_PERIOD_SECONDS=
