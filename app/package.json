{
  "name": "primerpaso-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "db:types": "node --env-file=.env.local scripts/generar-tipos.mjs",
    "indexar": "tsx --conditions=react-server --env-file=.env.local scripts/indexar.ts",
    "indexar:probar": "tsx --conditions=react-server --env-file=.env.local scripts/probar-indexador.ts",
    "renovar": "tsx --conditions=react-server --env-file=.env.local scripts/renovar.ts"
  },
  "dependencies": {
    "@stellar/freighter-api": "^6.0.0",
    "@stellar/stellar-sdk": "^17.2.1",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.58.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
